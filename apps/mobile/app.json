{
  "expo": {
    "name": "TropTix Organizer",
    "slug": "troptix-mobile",
    "owner": "troptix",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.usetroptix.organizerapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan event ticket QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.troptix.organizer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2EEE7"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TropTix to access your camera to scan ticket QR codes."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "troptix-organizer",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54ec09c0-18c7-4c98-835e-cb78f686a6d4"
      }
    }
  }
}
