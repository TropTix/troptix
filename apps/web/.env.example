# Copy to .env in this directory. Placeholders only; never commit real values.

# Database: Supabase project > Connect > ORMs (Prisma). Pooled URL for the app, direct URL for db:new / db:apply.
POSTGRES_PRISMA_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
PG_POOL_MAX=5

# Supabase: project > Settings > API Keys. The secret key is server-only, for scripts that bypass RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe: Developers > API keys (sandbox). Webhook secrets come from `stripe listen` or the webhook endpoint page.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_RESERVATION_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Point the Stripe SDK at a fake server instead of api.stripe.com. Leave unset outside tests.
STRIPE_API_BASE=

# PostHog: project > Settings > Project API key. Requests proxy through /ingest, so the host is PostHog's, not ours.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend: API Keys page.
RESEND_API_KEY=re_xxx

# Google Maps: Google Cloud console, Maps Platform credentials. Map ID is optional.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxx
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# App URL: the public origin. On Vercel it falls back to VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron: any long random string. /api/cron/* checks it as a bearer token and refuses when unset.
CRON_SECRET=

# Scripts, optional: db:new diffs against this ref (default origin/main); stripe-lab uses this as its return URL.
MIGRATION_BASE_REF=
LAB_BASE_URL=
