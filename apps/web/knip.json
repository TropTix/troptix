{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
    "scripts/*.ts",
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "src/app/_components/social-proof.tsx"
  ],
  "ignoreDependencies": [
    "@troptix/api",
    "@troptix/db",
    "@troptix/transactional",
    "@types/google.maps",
    "ts-node"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"]
  }
}
