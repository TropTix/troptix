{
  "name": "troptix",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "test": "pnpm --filter web test",
    "next": "pnpm --filter web dev",
    "dev": "npm-run-all --parallel next",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @troptix/db typecheck && pnpm --filter @troptix/api typecheck && pnpm --filter @troptix/transactional typecheck && pnpm --filter troptix-mobile typecheck",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity=error",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "create-jest": "^29.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.0.7",
    "oxlint": "1.83.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.1"
  },
  "private": true
}
