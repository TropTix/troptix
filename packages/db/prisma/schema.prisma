datasource db {
  provider = "postgresql"
  // Prisma 7: no URL here. CLI/migrate gets the direct 5432 URL from
  // prisma.config.ts; runtime uses the pooled URL via the pg adapter in packages/db/src/index.ts.
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  PATRON
  ORGANIZER
  PROMOTER
}

model Users {
  id                  String                @id @default(uuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  email               String                @unique
  // Supabase Auth key (ADR 0011); `id` stays the app PK — never assume equality
  // (migrated users differ). FK to auth.users is hand-appended SQL; nullable until the 1c backfill.
  authUserId          String?               @unique @db.Uuid
  name                String?
  firstName           String?
  lastName            String?
  stripeId            String?
  role                Role                  @default(PATRON)
  isPlatformOwner     Boolean               @default(false)
  tickets             Tickets[]
  orders              Orders[]
  socialMediaAccounts SocialMediaAccounts[]
  reservations        Reservation[]
  organizations       Organization[]
  memberships         Membership[]

  telephoneNumber String?
  billingAddress1 String?
  billingAddress2 String?
  billingCity     String?
  billingCountry  String?
  billingZip      String?
  billingState    String?
}

enum SocialMediaAccountType {
  UNKNOWN
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TWITTER
}

model SocialMediaAccounts {
  id                     String                 @id @default(uuid())
  socialMediaAccountType SocialMediaAccountType @default(UNKNOWN)
  link                   String?
  user                   Users?                 @relation(fields: [userId], references: [id])
  userId                 String?

  @@index([userId])
}

// `instagram`/`twitter` store usernames; `linkedin`/`website` store full URLs.
model Organization {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  displayName String
  logoUrl     String?  @db.VarChar(2000)
  bio         String?
  website     String?
  instagram   String?
  twitter     String?
  linkedin    String?
  ownerUserId String   @unique
  verified    Boolean  @default(false)

  paidTicketingEnabled     Boolean   @default(false)
  paidTicketingRequestedAt DateTime?

  owner       Users        @relation(fields: [ownerUserId], references: [id])
  events      Events[]
  memberships Membership[]
}

// Membership roles (ADR 0024). The Owner is never a row here — the
// `ownerUserId` scalar is the one answer to "who owns this".
enum MembershipRole {
  ADMIN
}

// The role covers every event the Organization owns — there are no per-event
// grants (ADR 0024).
model Membership {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  role      MembershipRole

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([organizationId, userId])
  @@index([userId])
}

model Spotlight {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  eventId     String
  title       String
  link        String?
  imageUrl    String?  @db.VarChar(2000)
  description String?  @db.VarChar(350)
  order       Int      @default(0)

  event Events @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

enum TicketStatus {
  AVAILABLE
  NOT_AVAILABLE
  // Canonical lifecycle (reservation rebuild, Phase A). AVAILABLE/NOT_AVAILABLE
  // are the deprecated pair, kept only until the cleanup migration drops them.
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum TicketType {
  FREE
  PAID
  COMPLEMENTARY
}

// Order-level transaction kind — distinct from the per-ticket TicketType enum.
enum OrderType {
  FREE
  PAID
  COMPLEMENTARY
}

enum ReservationStatus {
  HELD
  CONVERTED
  EXPIRED
  RELEASED
  // Paid after the hold expired and the tickets could not be re-acquired: the
  // PaymentIntent was auto-refunded (ADR 0018). Terminal, like CONVERTED.
  REFUNDED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Tickets {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  status      TicketStatus @default(NOT_AVAILABLE)
  ticketsType TicketType?  @default(PAID)
  fees        Float?
  subtotal    Float?
  total       Float?
  firstName   String?
  lastName    String?
  email       String?

  checkinTimestamp DateTime?

  event        Events       @relation(fields: [eventId], references: [id])
  eventId      String
  order        Orders       @relation(fields: [orderId], references: [id])
  orderId      String
  ticketType   TicketTypes? @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String?
  user         Users?       @relation(fields: [userId], references: [id])
  userId       String?

  // createdAt trails eventId so the sales trend range-scans its window; the
  // leading column also serves bare [eventId] lookups — don't re-add that index.
  @@index([eventId, createdAt])
  @@index([orderId])
  @@index([ticketTypeId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model Orders {
  id               String      @id @default(uuid())
  stripeCustomerId String?
  stripePaymentId  String?     @unique
  createdAt        DateTime?   @default(now())
  updatedAt        DateTime?   @updatedAt
  total            Float
  subtotal         Float?
  fees             Float?
  name             String?
  firstName        String?
  lastName         String?
  email            String?
  cardType         String?
  cardLast4        String?
  telephoneNumber  String?
  billingAddress1  String?
  billingAddress2  String?
  billingCity      String?
  billingCountry   String?
  billingZip       String?
  billingState     String?
  tickets          Tickets[]
  ticketsLink      String?
  // The unguessable secret behind the email's `?t=` link, gating order/tickets/
  // receipt pages for guests. Never a display code; null it to kill outstanding links.
  accessToken      String?     @unique
  status           OrderStatus @default(PENDING)

  // Reservation rebuild (Phase A — additive). Nullable until backfilled +
  // the cutover writes them; old Float columns retained until cleanup.
  type          OrderType?
  totalCents    Int?
  subtotalCents Int?
  feesCents     Int?
  reservation   Reservation?

  user    Users?  @relation(fields: [userId], references: [id])
  userId  String?
  event   Events  @relation(fields: [eventId], references: [id])
  eventId String

  @@index([eventId])
  // One index for both dashboard reads: the revenue aggregate seeks a status +
  // date range; recent-orders gets an ordered path instead of a top-N sort.
  @@index([eventId, status, createdAt])
  @@index([userId])
}

enum EventPageTheme {
  off
  wash
  dark
}

model Events {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDraft   Boolean   @default(true)
  isPrivate Boolean   @default(false)
  deletedAt DateTime?

  imageUrl        String? @db.VarChar(2000)
  name            String
  description     String  @db.VarChar(4000)
  summary         String?
  organizer       String
  organizerUserId String
  // Auth still keys on organizerUserId — a legacy key dual-written ==
  // organization.ownerUserId — until the query-key flip to organizationId (ADR 0022).
  organizationId  String

  // Full timestamps — the event form folds the time input into these before
  // submitting; never add a separate date or time column (ADR 0020).
  startsAt DateTime
  endsAt   DateTime

  venue       String?
  address     String
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?

  // Extracted once from the flyer at upload, stored raw (hex strings) so the
  // derivation can evolve in code without a backfill (apps/web/src/lib/flyerTheme.ts).
  pageTheme    EventPageTheme @default(off)
  flyerPalette Json?

  tickets      Tickets[]
  ticketTypes  TicketTypes[]
  orders       Orders[]
  reservations Reservation[]

  organization Organization @relation(fields: [organizationId], references: [id])
  spotlight    Spotlight[]

  @@index([organizationId])
  @@index([organizerUserId])
}

enum TicketFeeStructure {
  ABSORB_TICKET_FEES
  PASS_TICKET_FEES
}

model TicketTypes {
  id         String      @id @default(uuid())
  ticketType TicketType? @default(PAID)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  name               String
  description        String
  maxPurchasePerUser Int

  // Counter inventory — one standard: availability = capacity - reserved - sold.
  capacity Int // immutable total for this tier
  reserved Int @default(0) // held by active, unexpired reservations
  sold     Int @default(0) // confirmed/paid

  // Full timestamps — the ticket form folds the time input into these before
  // submitting; never add a separate date or time column (ADR 0020).
  saleStartsAt DateTime
  saleEndsAt   DateTime

  price         Float
  priceCents    Int?
  ticketingFees TicketFeeStructure @default(PASS_TICKET_FEES)

  event            Events            @relation(fields: [eventId], references: [id])
  eventId          String
  discountCode     String?
  tickets          Tickets[]
  reservationItems ReservationItem[]

  @@index([eventId])
}

// The Order is materialized only when the hold is confirmed.
model Reservation {
  id                      String            @id @default(uuid())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  status                  ReservationStatus @default(HELD)
  expiresAt               DateTime
  stripePaymentIntentId   String?           @unique
  // The Session drives the paid flow (ADR 0018); its PaymentIntent id lands in
  // `stripePaymentIntentId` only at confirm. `stripeRefundId` is set on the expiry-race refund.
  stripeCheckoutSessionId String?           @unique
  stripeRefundId          String?

  email     String?
  firstName String?
  lastName  String?

  // Buyer's PostHog browser identity, captured at hold time so the server-side
  // conversion event joins the same person and replay; null when analytics is blocked.
  posthogDistinctId String?
  posthogSessionId  String?

  totalCents    Int @default(0)
  subtotalCents Int @default(0)
  feesCents     Int @default(0)

  items   ReservationItem[]
  event   Events            @relation(fields: [eventId], references: [id])
  eventId String
  user    Users?            @relation(fields: [userId], references: [id])
  userId  String?
  order   Orders?           @relation(fields: [orderId], references: [id])
  orderId String?           @unique

  @@index([eventId])
  @@index([status])
  @@index([expiresAt])
}

model ReservationItem {
  id             String      @id @default(uuid())
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId  String
  ticketType     TicketTypes @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId   String
  quantity       Int
  unitPriceCents Int         @default(0)
  feesCents      Int         @default(0)

  @@index([reservationId])
  @@index([ticketTypeId])
}

// Transactional outbox — rows are written in the same transaction as
// confirm_reservation and dispatched after commit, so a slow/failed email can never roll back a confirmed payment.
model OutboxMessage {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  processedAt DateTime?

  @@index([status])
}

// Stripe webhook idempotency ledger (deliveries are at-least-once). The PK IS
// the Stripe event id — a conflicting INSERT means already processed; never add a uuid default.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
